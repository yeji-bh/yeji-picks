generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  account      String         @unique
  passwordHash String         @map("password_hash")
  role         String         @default("user")
  createdAt    DateTime       @default(now()) @map("created_at")
  submissions  Submission[]
  favorites    Favorite[]
  sessions     Session[]
  outfits       Outfit[]
  feedback      SiteFeedback[]
  catalogDupes  CatalogDupe[]
  outfitReviews OutfitReview[]

  @@map("users")
}

model SiteFeedback {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  category  String   @default("suggestion")
  message   String
  image     String?
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("site_feedback")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  targetId  String   @map("target_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, targetId])
  @@map("favorites")
}

model Outfit {
  id          String       @id @default(cuid())
  eventName   String       @map("event_name")
  date        String
  mainImage   String       @map("main_image")
  userId      String?      @map("user_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  outfitItems OutfitItem[]
  reports     Report[]
  reviews     OutfitReview[]

  @@map("outfits")
}

model OutfitReview {
  id        String   @id @default(cuid())
  outfitId  String   @map("outfit_id")
  userId    String?  @map("user_id")
  actorKey  String   @map("actor_key")
  nickname  String?
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([outfitId, actorKey])
  @@map("outfit_reviews")
}

model CatalogItem {
  id            String             @id @default(cuid())
  type          String
  brand         String?
  brandKey      String?            @map("brand_key")
  productName   String?            @map("product_name")
  officialLink  String?            @map("official_link")
  notes         String?
  linkStatus    String?            @map("link_status")
  linkCheckedAt DateTime?          @map("link_checked_at")
  useCount      Int                @default(0) @map("use_count")
  createdAt     DateTime           @default(now()) @map("created_at")
  images        CatalogItemImage[]
  placements    OutfitItem[]
  reports       Report[]
  dupes         CatalogDupe[]

  @@index([brandKey])
  @@map("catalog_items")
}

model CatalogDupe {
  id            String      @id @default(cuid())
  catalogItemId String      @map("catalog_item_id")
  userId        String?     @map("user_id")
  image         String
  brand         String
  productName   String?     @map("product_name")
  priceRange    String?     @map("price_range")
  buyLink       String      @map("buy_link")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes         DupeVote[]

  @@map("catalog_dupes")
}

model DupeVote {
  id        String      @id @default(cuid())
  dupeId    String      @map("dupe_id")
  voterKey  String      @map("voter_key")
  vote      String
  createdAt DateTime    @default(now()) @map("created_at")
  dupe      CatalogDupe @relation(fields: [dupeId], references: [id], onDelete: Cascade)

  @@unique([dupeId, voterKey])
  @@map("dupe_votes")
}

model CatalogItemImage {
  id            String      @id @default(cuid())
  catalogItemId String      @map("catalog_item_id")
  url           String
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@map("catalog_item_images")
}

model OutfitItem {
  id            String      @id @default(cuid())
  outfitId      String      @map("outfit_id")
  catalogItemId String      @map("catalog_item_id")
  outfit        Outfit      @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@unique([outfitId, catalogItemId])
  @@map("outfit_items")
}

model Report {
  id            String       @id @default(cuid())
  outfitId      String       @map("outfit_id")
  catalogItemId String?      @map("catalog_item_id")
  message       String
  status        String       @default("pending")
  createdAt     DateTime     @default(now()) @map("created_at")
  outfit        Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Submission {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  status    String   @default("pending")
  rawJson   String   @map("raw_json")
  outfitId  String?  @map("outfit_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("submissions")
}

model NailArt {
  id        String   @id @default(cuid())
  image     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("nail_arts")
}

model PhoneCase {
  id           String   @id @default(cuid())
  image        String
  brand        String
  model        String
  officialLink String   @default("") @map("official_link")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("phone_cases")
}

model Perfume {
  id           String   @id @default(cuid())
  image        String
  name         String
  brand        String
  description  String   @default("")
  officialLink String   @default("") @map("official_link")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("perfumes")
}
