# Local SQLite (dev): file:./local.db
# Turso (prod): libsql://your-db-name.turso.io
DATABASE_URL="file:./local.db"

# Turso auth token (only needed for remote Turso database)
TURSO_AUTH_TOKEN=""

# Admin login secret
ADMIN_SECRET=""

# Cloudflare R2 (production image storage)
# Account ID from R2 S3 endpoint: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Public CDN URL for uploaded images (R2 dev URL or custom domain)
# e.g. https://pub-xxxx.r2.dev  or  https://cdn.yourdomain.com
# DB stores /uploads/{uuid}.webp — this base + filename is the public URL
NEXT_PUBLIC_ASSET_BASE_URL=""

# Cloudflare Workers Builds (not Pages):
#   Build command:  npm run cf:build
#   Deploy command: npm run cf:deploy
