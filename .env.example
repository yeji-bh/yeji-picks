# Local SQLite (dev): file:./prisma/local.db
# Turso (prod): libsql://your-db-name.turso.io
DATABASE_URL="file:./prisma/local.db"

# Turso auth token (only needed for remote Turso database)
TURSO_AUTH_TOKEN=""

# Admin login secret
ADMIN_SECRET=""

# Cloudflare R2 (production image storage)
# Account ID from R2 S3 endpoint: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# On Cloudflare Workers, set ALL four as encrypted secrets (Dashboard or wrangler secret put):
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Public CDN URL for uploaded images (R2 custom domain)
# Grid views can load `{uuid}_t.webp` thumbs when NEXT_PUBLIC_GRID_THUMBS=1 (after batch generation).
ASSET_BASE_URL="https://img.yejipicks.top"
NEXT_PUBLIC_ASSET_BASE_URL="https://img.yejipicks.top"
# NEXT_PUBLIC_GRID_THUMBS=1

# Cloudflare Workers Builds (not Pages):
#   Build command:  npm run cf:build
#   Deploy command: npm run cf:deploy
