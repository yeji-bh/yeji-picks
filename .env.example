# Local SQLite (dev): file:./local.db
# Turso (prod): libsql://your-db-name.turso.io
DATABASE_URL="file:./local.db"

# Turso auth token (only needed for remote Turso database)
TURSO_AUTH_TOKEN=""

# Optional CDN / object storage base URL for uploaded images
# e.g. https://cdn.example.com or https://your-bucket.oss-cn-hangzhou.aliyuncs.com
NEXT_PUBLIC_ASSET_BASE_URL=""

# Item image AI background removal on upload (set to false to disable)
ITEM_BG_REMOVAL="true"
