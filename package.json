{
  "name": "yeji-outfits",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:setup-turso": "node --env-file=.env scripts/setup-turso.mjs",
    "db:migrate-catalog": "node --env-file=.env scripts/migrate-catalog-items.mjs",
    "db:restore-items": "node --env-file=.env scripts/restore-items.mjs",
    "db:repair-items": "node --env-file=.env scripts/restore-items.mjs --repair",
    "db:process-item-bg": "node --env-file=.env scripts/process-item-backgrounds.mjs",
    "db:cleanup-uploads": "node --env-file=.env scripts/cleanup-orphan-uploads.mjs",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@libsql/client": "^0.14.0",
    "@prisma/adapter-libsql": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "heic2any": "^0.0.4",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.5.7",
    "react-i18next": "^17.0.8",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2"
  }
}
