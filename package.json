{
  "name": "yeji-outfits",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node -e \"const u=process.env.DATABASE_URL||'';if(!u.startsWith('file:')){console.error('\\n  此專案使用 Turso（libsql://），請改用：\\n  npm run db:setup-turso\\n');process.exit(1)}\" && prisma db push",
    "db:setup-turso": "node --env-file=.env scripts/setup-turso.mjs",
    "db:migrate-catalog": "node --env-file=.env scripts/migrate-catalog-items.mjs",
    "db:restore-items": "node --env-file=.env scripts/restore-items.mjs",
    "db:repair-items": "node --env-file=.env scripts/restore-items.mjs --repair",
    "db:cleanup-uploads": "node --env-file=.env scripts/cleanup-orphan-uploads.mjs",
    "db:migrate-uploads-r2": "node --env-file=.env scripts/migrate-uploads-to-r2.mjs",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@libsql/client": "^0.14.0",
    "@prisma/adapter-libsql": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "heic2any": "^0.0.4",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.5.7",
    "react-i18next": "^17.0.8",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.9.3",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2"
  }
}
